# ============================================================
#  Global Command Center — Environment Variables
#  Copy this to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore
# ============================================================

# --- Paid APIs (Netlify Functions-only scope — NEVER expose to Builds) ---
GEMINI_API_KEY=your_gemini_key_here
# Optional tested model override for intelligence briefs.
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
SERPER_API_KEY=your_serper_key_here
# Optional: set to "true" to merge Serper into the scheduled public feed (defaults to off; free institutional feeds run by default).
ENABLE_SERPER_PUBLIC_FEED=false
# Optional: free approved ReliefWeb API v2 appname (https://apidoc.reliefweb.int/parameters#appname).
RELIEFWEB_APPNAME=
GOOGLE_NL_API_KEY=your_google_cloud_nl_key_here

# --- Firecrawl (web scraping, Functions-only scope) ---
FIRECRAWL_API_KEY=your_firecrawl_key_here

# --- Paid Endpoint Durable Caps & Sign-In Allow-List (optional) ---
# Global UTC daily caps across all users (0 disables endpoint; defaults: 200, 100, 300).
AI_SUMMARY_DAILY_CAP=200
DEEP_SCAN_DAILY_CAP=100
FETCH_NEWS_DAILY_CAP=300
# Optional comma-separated case-insensitive allow-lists (leave blank to permit all signed-in accounts).
ALLOWED_SIGNIN_EMAILS=
ALLOWED_SIGNIN_DOMAINS=

# --- Supabase (shared project) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Server-side Supabase values used to validate function callers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here

# Optional comma-separated origins for previews or custom domains.
ALLOWED_ORIGINS=https://preview.example.org

# Optional >=16-char shared secret so scheduled refresh-source-health can dispatch
# to the 15-minute refresh-source-health-background worker as the case library scales.
CRON_SECRET=replace_with_random_secret_at_least_16_chars
