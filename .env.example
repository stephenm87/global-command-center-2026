# ============================================================
#  Global Command Center — Environment Variables
#  Copy this to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore
# ============================================================

# --- AI APIs ---
GEMINI_API_KEY=your_gemini_key_here
# Optional tested model override for intelligence briefs.
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
SERPER_API_KEY=your_serper_key_here
GNEWS_API_KEY=your_gnews_key_here
GOOGLE_NL_API_KEY=your_google_cloud_nl_key_here

# --- Firecrawl (web scraping) ---
FIRECRAWL_API_KEY=your_firecrawl_key_here

# --- Supabase (shared project) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side Supabase values used to validate function callers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here

# Optional comma-separated origins for previews or custom domains.
ALLOWED_ORIGINS=https://preview.example.org
