{
    "name": "global-command-center",
    "version": "1.0.0",
    "private": true,
    "dependencies": {
        "@netlify/blobs": "^9.1.5",
        "@supabase/supabase-js": "2.103.2",
        "globe.gl": "^2.31.1",
        "papaparse": "^5.4.1",
        "react": "^18.2.0",
        "react-dom": "^19.2.8",
        "react-force-graph-3d": "^1.29.1",
        "three": "^0.184.0",
        "topojson-client": "^3.1.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.7.0",
        "vite": "^5.4.21"
    },
    "overrides": {
        "ws": "^8.21.0"
    },
    "scripts": {
        "dev": "vite",
        "sources:manifest": "node scripts/generate-source-health-manifest.mjs",
        "sources:manifest:check": "node scripts/generate-source-health-manifest.mjs --check",
        "build": "npm run sources:manifest && vite build",
        "test": "npm run sources:manifest:check && node --test netlify/functions/__tests__/*.node.test.js src/__tests__/*.node.test.*",
        "preview": "vite preview"
